# ==============================================================================
# ZeroCAC Environment Configuration
# ==============================================================================

# Server Configuration
ZEROCAC_HOST=0.0.0.0
ZEROCAC_PORT=8000
ZEROCAC_ENV=development
ZEROCAC_DEBUG=false

# Default AI Provider & Models (Options: openai, gemini, claude, nvidia, deepseek, ollama)
DEFAULT_AI_PROVIDER=openai
DEFAULT_STRATEGY_MODEL=gpt-6-astra
DEFAULT_FAST_MODEL=gpt-6.1-luna

# ------------------------------------------------------------------------------
# 1. OpenAI Configuration (GPT-6 Astra, GPT-6.1 Luna, gpt-oss)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_STRATEGY=gpt-6-astra
OPENAI_MODEL_FAST=gpt-6.1-luna

# ------------------------------------------------------------------------------
# 2. Google Gemini Configuration (Gemini 4 Argon, Gemini 3.8 Flash)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_STRATEGY=gemini-4-argon
GEMINI_MODEL_FAST=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 3. Anthropic Claude Configuration (Claude Opus 5.5, Claude Sonnet 5.5)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_STRATEGY=claude-opus-5-5
ANTHROPIC_MODEL_FAST=claude-sonnet-5-5

# ------------------------------------------------------------------------------
# 4. NVIDIA NIM Configuration (Nemotron 3 Ultra 550B, Nemotron 3.5 Super VL)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_STRATEGY=nemotron-3-ultra
NVIDIA_MODEL_FAST=nemotron-3.5-super-vl

# ------------------------------------------------------------------------------
# 5. DeepSeek Configuration (DeepSeek-V4.1-Flash, DeepSeek-R1)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_STRATEGY=deepseek-r1
DEEPSEEK_MODEL_FAST=deepseek-v4.1-flash

# ------------------------------------------------------------------------------
# 6. Local Fallback (Ollama / vLLM)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3
